# LLM provider: "openai" | "anthropic" | "google"
LLM_PROVIDER=openai

# Optional model override (defaults: gpt-4o, claude-sonnet-4-20250514, gemini-2.5-flash)
LLM_MODEL=gpt-4o

# Provide the API key matching LLM_PROVIDER
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional default local project directory path to prefill in the workspace selector
DEFAULT_WORKSPACE_PATH=

# Template Git repository URL cloned when creating a new project
TEMPLATE_REPO_URL=https://github.com/fgabriel78/dept-app-brief.git

# Parent directory where newly created project folders are placed (defaults to parent of workbench)
PROJECTS_ROOT_DIR=
